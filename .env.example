# --- Database ---
# Postgres connection string (async driver)
DATABASE_URL=postgresql+asyncpg://postgres:sudin@localhost:5432/rag_db
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:sudin@localhost:5432/rag_db

# --- Auth ---
JWT_SECRET_KEY=mysecretkey12345678
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- LLM Provider ---
# Get a free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
LLM_MODEL=gemini-flash-latest

# --- Embeddings ---
# Runs locally via sentence-transformers, no key needed
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Chunking ---
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K_RESULTS=4

# --- App ---
ENVIRONMENT=development
